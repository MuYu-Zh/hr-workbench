{
  "name": "hr-workbench",
  "productName": "人事工作台",
  "version": "1.2.0",
  "description": "个人人事管理：员工档案、招聘、组织架构、待办备忘录、常用网址，数据本地存储",
  "main": "electron/main.js",
  "author": "MuYu-Zh",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "pack:win": "npm run build && electron-builder --win nsis portable",
    "pack:mac": "npm run build && electron-builder --mac dmg zip",
    "pack:all": "npm run build && electron-builder --win nsis portable --mac dmg zip",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "echarts": "^5.5.0",
    "element-plus": "^2.7.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^5.2.0"
  },
  "build": {
    "appId": "com.muyuzh.hrworkbench",
    "productName": "人事工作台",
    "directories": {
      "output": "dist",
      "buildResources": "electron/build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!tools",
      "!*.md"
    ],
    "asar": true,
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "人事工作台",
      "artifactName": "人事工作台-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "人事工作台-便携版-${version}.${ext}"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "icon": "public/icons/icon-512.png",
      "category": "public.app-category.business"
    },
    "dmg": {
      "artifactName": "人事工作台-${version}-${arch}.${ext}"
    },
    "electronLanguages": ["zh-CN", "en-US"],
    "publish": {
      "provider": "github",
      "owner": "MuYu-Zh",
      "repo": "hr-workbench"
    }
  }
}
